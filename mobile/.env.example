# Which poap.live the app uses. The app reads this at build time.
# Production is https://poap.live; for local testing point it at your
# machine (an ngrok URL works on a real phone).
EXPO_PUBLIC_API_URL=https://poap.live

# Optional. The XRP Ledger JSON-RPC node the phone submits to and reads its
# wallet from. Left unset, the app asks poap.live which network it is on and
# uses Ripple's public node for it. It must be on the same network.
# EXPO_PUBLIC_XRPL_RPC=https://s1.ripple.com:51234/
